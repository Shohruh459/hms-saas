NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Demo/dev uchun: bitta tenant bilan ishlashda uning ID'si (x-tenant-id header
# sifatida yuboriladi). Production'da bu subdomen orqali server-side aniqlanadi.
NEXT_PUBLIC_TENANT_ID=

# Bo'sh qoldirilsa (platforma/discovery deploy) — bosh sahifa mehmonxonalarni
# kashf etish rejimida ochiladi. Har bir mehmonxonaning o'z subdomeni orqali
# ("Xonani bron qilish" tugmasi) ochilishi uchun asosiy domen (masalan mehmon.uz).
NEXT_PUBLIC_ROOT_DOMAIN=
