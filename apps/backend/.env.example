DATABASE_URL=postgresql://hms:hms@localhost:5432/hms
REDIS_URL=redis://localhost:6379
PORT=3001

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Xavfsizlik — vergul bilan ajratilgan ruxsat etilgan frontend manzillari (CORS)
CORS_ORIGIN=http://localhost:3000

# Payments
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
STRIPE_SECRET_KEY=

# Cloudflare R2 (S3-compatible) — mehmonxona ro'yxatdan o'tish videolari
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hms-videos
R2_PUBLIC_BASE_URL=https://<public-bucket-domain>
