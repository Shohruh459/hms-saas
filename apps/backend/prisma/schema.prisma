generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_OWNER
  RECEPTIONIST
  HOUSEKEEPER
  GUEST
}

/// Superadmin panelidan foydalanishga ruxsat berilgan elektron pochtalar.
/// ROOT_SUPER_ADMIN_EMAIL (kodda qattiq belgilangan) doim ruxsatga ega —
/// bu jadval faqat u tomonidan QO'SHIMCHA qo'shilgan pochtalarni saqlaydi.
model AllowedSuperadminEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  grantedBy String
  createdAt DateTime @default(now())
}

enum TenantStatus {
  PENDING
  ACTIVE
  BLOCKED
  EXPIRED
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  subdomain          String       @unique
  customDomain       String?      @unique
  locale             String       @default("uz")
  address            String?
  phone              String?
  latitude           Float?
  longitude          Float?
  /// { click: {...}, payme: {...}, stripe: {...} } — provayder kalitlari/credentiallari
  paymentKeys        Json?
  status             TenantStatus @default(ACTIVE)
  subscriptionEndsAt DateTime?
  /// Ro'yxatdan o'tish videosi — R2'ga yuklangan fayl manzili
  videoUrl           String?
  videoApproved      Boolean      @default(false)
  /// Ochiq (discovery) API'da hudud bo'yicha filtrlash uchun (masalan "Toshkent")
  region             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users           User[]
  rooms           Room[]
  serviceRequests ServiceRequest[]
  supportTickets  SupportTicket[]
  bookings        Booking[]
  payments        Payment[]
  feedbacks       Feedback[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  fullName     String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  role         UserRole @default(GUEST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests ServiceRequest[] @relation("GuestServiceRequests")
  supportTickets  SupportTicket[]
  bookings        Booking[]

  @@index([tenantId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

/// PRIVATE — butun xona bir guruh/mehmonga beriladi (eski standart xatti-harakat).
/// SHARED — xona koyka (bed) asosida alohida mehmonlarga bo'lib bron qilinadi (hostel turi).
enum RoomType {
  PRIVATE
  SHARED
}

/// SHARED xonalar uchun jins bo'yicha cheklov siyosati.
enum GenderPolicy {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum GuestGender {
  MALE
  FEMALE
}

model Room {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  roomNumber    String
  floor         Int
  /// Xona uslubi/darajasi (masalan "Standard", "Deluxe", "Suite") — erkin matn yorlig'i.
  category      String
  pricePerNight Decimal      @db.Decimal(10, 2)
  capacity      Int          @default(2)
  rating        Decimal?     @db.Decimal(2, 1)
  amenities     String[]     @default([])
  status        RoomStatus   @default(AVAILABLE)
  /// PRIVATE (butun xona) yoki SHARED (koyka asosida, hostel).
  type          RoomType     @default(PRIVATE)
  genderPolicy  GenderPolicy @default(MIXED)
  /// SHARED xonalardagi jami koykalar soni (PRIVATE uchun odatda 1).
  totalBeds     Int          @default(1)
  /// SHARED xonalar uchun bitta koyka narxi (mavjud bo'lmasa PRIVATE xona hisoblanadi).
  pricePerBed   Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  serviceRequests ServiceRequest[]
  bookings        Booking[]

  @@unique([tenantId, roomNumber])
  @@index([tenantId])
}

enum ServiceRequestStatus {
  PENDING_ADMIN
  APPROVED_BY_ADMIN
  REJECTED_BY_ADMIN
  COMPLETED
  FAILED
}

model ServiceRequest {
  id         String               @id @default(uuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  roomId     String
  room       Room                 @relation(fields: [roomId], references: [id])
  guestId    String
  guest      User                 @relation("GuestServiceRequests", fields: [guestId], references: [id])
  reason     String
  status     ServiceRequestStatus @default(PENDING_ADMIN)
  staffNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([tenantId, status])
}

enum SupportTicketType {
  COMPLAINT
  HELP
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String               @id @default(uuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  guestId   String
  guest     User                 @relation(fields: [guestId], references: [id])
  type      SupportTicketType
  message   String
  status    SupportTicketStatus  @default(OPEN)
  response  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId, status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Booking {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  guestId       String
  guest         User          @relation(fields: [guestId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  /// SHARED xonalarda mehmon egallayotgan koykalar soni (PRIVATE uchun mazmuni yo'q, doim 1).
  bedsBooked    Int           @default(1)
  /// SHARED xonalarda jins siyosati va bir xonadagi mehmonlar jinsini moslashtirish uchun.
  guestGender   GuestGender?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  @@index([tenantId, status])
}

enum PaymentProvider {
  CLICK
  PAYME
  STRIPE
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bookingId     String
  booking       Booking         @relation(fields: [bookingId], references: [id])
  provider      PaymentProvider
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([provider, transactionId])
  @@index([tenantId, status])
  @@index([bookingId])
}

enum FeedbackCategory {
  COMPLAINT
  SUGGESTION
  GENERAL
}

enum FeedbackStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

/// "AI Shikoyat va Takliflar" — mehmonlar (autentifikatsiyasiz) yuboradigan
/// murojaatlar. AI javob (aiSummary) darhol generatsiya qilinadi, keyinroq
/// Superadmin haqiqiy javob (adminReply) yozib, statusni RESOLVED qiladi.
model Feedback {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  roomNumber String?
  guestPhone String?
  guestName  String?
  category   FeedbackCategory @default(GENERAL)
  message    String
  /// AI tomonidan chiqarilgan qisqa mazmun (superadmin panelida tezkor ko'rish uchun)
  aiSummary  String?
  status     FeedbackStatus   @default(PENDING)
  adminReply String?
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([guestPhone])
}
