# Production muhiti uchun namuna. Nusxalab `.env.production` deb saqlang
# va haqiqiy qiymatlarni kiriting:
#   cp .env.production.example .env.production
#
# Server/domen hali aniq bo'lmasa, DOMAIN_NAME=localhost bilan
# to'liq lokal Docker muhitida sinab ko'rish mumkin.

# --- Domen ---
# Server sotib olingach va domen aniq bo'lgach shu yerga yozing
# (masalan: mehmon.uz). Hozircha localhost qoldiring.
DOMAIN_NAME=localhost

# --- PostgreSQL ---
POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hms

# --- Backend (NestJS) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Vergul bilan ajratilgan ruxsat etilgan manzillar (frontend + kelajakda
# Capacitor mobil ilovalar). Nginx orqali frontend/backend bir domenda
# bo'lgani uchun bu asosan to'g'ridan-to'g'ri API murojaatlari va mobil
# ilovalar uchun kerak.
CORS_ORIGIN=http://localhost,http://localhost:3000

# Cloudflare R2 (S3-compatible) — mehmonxona ro'yxatdan o'tish videolari
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hms-videos
R2_PUBLIC_BASE_URL=https://<public-bucket-domain>

# --- Frontend (Next.js, build vaqtida brauzerga yoziladi) ---
# Nginx /api/ ni backend'ga proxy qiladi, shuning uchun nisbiy yo'l
# ishlatiladi — domen o'zgarganda ham qayta sozlash shart emas.
NEXT_PUBLIC_API_URL=/api
# Bo'sh qoldirilsa, Socket.IO joriy domenga (nisbiy) ulanadi.
NEXT_PUBLIC_SOCKET_URL=
# Demo/bitta-tenant rejimi uchun (ixtiyoriy) — mehmonxona tenant ID'si.
NEXT_PUBLIC_TENANT_ID=
# Bo'sh qoldirilsa, bosh sahifa mehmonxonalarni kashf etish (discovery)
# rejimida ishlaydi. To'ldirilsa (masalan mehmon.uz), "Xonani bron qilish"
# tugmasi shu domenning mehmonxona subdomeniga yo'naltiradi.
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Certbot (SSL) ---
# Domen aniqlangach, sertifikat so'rovi uchun ishlatiladi (DEPLOYMENT.md).
CERTBOT_EMAIL=admin@example.com
